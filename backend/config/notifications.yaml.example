# Email notifications. Copy this file to notifications.yaml next to config.yaml
# (on the server: /opt/design-profile/shared/config/notifications.yaml) and restart
# the backend. Without the file, or with no recipients, no emails are sent.
#
# The file holds personal email addresses, so it is not committed to git.
# Emails go out through the SMTP account of config.yaml (email section).

# Public address of the site: the email links to the request in the admin panel.
site_url: https://example.com

# Everyone here gets an email about each new project request from the site.
new_order:
  recipients:
    - designer@example.com
    # - assistant@example.com

# How the notifications are sent out (the outbox worker). Every value is optional:
# what is left out keeps the default shown here. Durations: 500ms, 30s, 2m, 1h.
outbox:
  # Pause after a sent notification before the next one (0s for none).
  delay: 1s
  # Pause after a temporary failure (mail server down, "try again later"); the
  # failed notification is tried again after it too. At least 1s.
  error_delay: 1m
  # How often to look for notifications while there are none. At least 1s;
  # a new request is still emailed at once.
  no_tasks_delay: 15s
