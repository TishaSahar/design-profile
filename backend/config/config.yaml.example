server:
  host: 0.0.0.0
  port: 8080

database:
  host: localhost
  port: 5432
  name: design_portfolio
  user: postgres
  password: your_db_password
  ssl_mode: disable

email:
  smtp_host: smtp.gmail.com
  smtp_port: 587
  username: your-app@gmail.com
  # Gmail App Password: Google Account → Security → App passwords
  password: xxxx xxxx xxxx xxxx
  sender: your-app@gmail.com
  admin_email: admin@example.com   # OTP codes are sent here

jwt:
  # Generate with: openssl rand -base64 32
  secret: change-this-to-a-long-random-secret-key-at-least-32-chars
  expiration_hours: 24
